# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Packaging (src layout)
*.egg-info/
build/
dist/

# OS
.DS_Store

# Logs
logs/

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/*.pdf

# Large / regenerable results: per-round histories, checkpoints, and the
# per-run summary JSONs + launcher logs the sweep produces.
results/**/*.json
results/**/checkpoints/
results/checkpoints/
results/runs/
results/data/runs/

# results/data/*.csv is deliberately NOT ignored -- the tidy per-run summaries
# (runs.csv from the log harvest, runs_v2.csv from collect_runs.py) are the
# committed evidentiary base for the paper.
!results/data/*.csv
