# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Packaging (src layout)
*.egg-info/
build/
dist/

# OS
.DS_Store

# Logs
logs/

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/*.pdf

# Large result files (regenerable): per-round histories and checkpoints.
results/**/*.json
results/**/checkpoints/
results/checkpoints/

# results/data/*.csv is deliberately NOT ignored -- the tidy per-run summaries
# are the committed evidentiary base for the paper. See scripts/harvest_logs.py.
!results/data/*.csv
