# Python
__pycache__/
*.pyc
*.pyo
.venv/
venv/

# Packaging (src layout)
*.egg-info/
build/
dist/

# OS
.DS_Store

# Logs
logs/

# Run-chain scratch summaries. scripts/run_*.sh write these -- they are
# regenerable output of summarize_runs.py, not source, and RESULTS.md is the
# place a reading gets written down.
*_STATUS.md

# LaTeX build artifacts
paper/*.aux
paper/*.log
paper/*.out
paper/*.toc
paper/*.synctex.gz
paper/*.fls
paper/*.fdb_latexmk
paper/*.bbl
paper/*.blg
paper/*.pdf

# Large / regenerable results: per-round histories, checkpoints, and the
# per-run summary JSONs + launcher logs the sweep produces.
results/**/*.json
results/**/checkpoints/
results/checkpoints/
# ...with ONE tracked exception, 740 files / 629 MB under
# results/experiments/exp7_mechanistic/*/checkpoints/. Those predate this rule
# and are not orphans: analysis/mechanistic.py::run_analysis and
# scripts/plotting/plot_exp7_mechanistic.py read them directly, so untracking
# them would leave both unable to run from a fresh clone. Everything written
# since is ignored as intended.
results/runs/
results/data/runs/

# results/data/*.csv is deliberately NOT ignored -- the tidy per-run summaries
# (runs.csv from the log harvest, runs_v2.csv from collect_runs.py) are the
# committed evidentiary base for the paper.
!results/data/*.csv
