\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Grokking success rate (fraction of 3 seeds that reach 95\% test accuracy). \textbf  {Left}: centralized-reduced. \textbf  {Right}: FL IID. The contrast is stark: centralized-reduced groks in only 1 of 30 cells, while FL groks in 23 of 30.}}{6}{figure.caption.13}\protected@file@percent }
\newlabel{fig:exp2_heatmaps}{{5}{6}{Grokking success rate (fraction of 3 seeds that reach 95\% test accuracy). \textbf {Left}: centralized-reduced. \textbf {Right}: FL IID. The contrast is stark: centralized-reduced groks in only 1 of 30 cells, while FL groks in 23 of 30}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Aggregation benefit: $T_{\text  {grok}}^{\text  {reduced}} / T_{\text  {grok}}^{\text  {FL}}$. Values $> 1$ mean FL groks faster than centralized-reduced. $\infty $ means FL groks but centralized-reduced never does---the maximum possible benefit.}}{7}{figure.caption.15}\protected@file@percent }
\newlabel{fig:exp2_benefit}{{6}{7}{Aggregation benefit: $T_{\text {grok}}^{\text {reduced}} / T_{\text {grok}}^{\text {FL}}$. Values $> 1$ mean FL groks faster than centralized-reduced. $\infty $ means FL groks but centralized-reduced never does---the maximum possible benefit}{figure.caption.15}{}}
\@writefile{toc}{\contentsline {section}{\numberline {8}Mechanistic Analysis}{8}{section.8}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.1}Fourier Structure Emergence}{8}{subsection.8.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces IPR (Fourier structure metric) over time for four representative cells. When grokking occurs, IPR rises from $\sim 0.02$ (random) to $\sim 0.35$--$0.47$ (structured). Centralized-reduced (red dashed) never develops Fourier structure in any panel except the first.}}{8}{figure.caption.17}\protected@file@percent }
\newlabel{fig:exp2_ipr}{{7}{8}{IPR (Fourier structure metric) over time for four representative cells. When grokking occurs, IPR rises from $\sim 0.02$ (random) to $\sim 0.35$--$0.47$ (structured). Centralized-reduced (red dashed) never develops Fourier structure in any panel except the first}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {paragraph}{Key observations.}{8}{section*.18}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.2}Same Pathway to Grokking}{8}{subsection.8.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Key observations.}{8}{section*.20}\protected@file@percent }
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Weight Norm Dynamics}{8}{subsection.8.3}\protected@file@percent }
