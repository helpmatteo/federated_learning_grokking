\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Phase portrait: trajectories in (IPR, test accuracy) space. \textbf  {Left}: centralized-full. \textbf  {Right}: FL IID. Multiple $(\alpha , K)$ configurations overlay near-perfectly, indicating a universal grokking pathway.}}{9}{figure.caption.19}\protected@file@percent }
\newlabel{fig:exp2_portrait}{{8}{9}{Phase portrait: trajectories in (IPR, test accuracy) space. \textbf {Left}: centralized-full. \textbf {Right}: FL IID. Multiple $(\alpha , K)$ configurations overlay near-perfectly, indicating a universal grokking pathway}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.4}Loss Dynamics: Memorisation Before Generalisation}{9}{subsection.8.4}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Key observations.}{9}{section*.24}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Weight norms ($\|W_1\|_F$ and $\|W_2\|_F$) over time. Grokking coincides with sustained weight growth; failed conditions show early plateauing or divergent growth without structure formation.}}{10}{figure.caption.21}\protected@file@percent }
\newlabel{fig:exp2_weights}{{9}{10}{Weight norms ($\|W_1\|_F$ and $\|W_2\|_F$) over time. Grokking coincides with sustained weight growth; failed conditions show early plateauing or divergent growth without structure formation}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces Train loss (top) and test loss (bottom) on log scale. The classic grokking signature: train loss drops immediately (memorisation), test loss follows much later (generalisation).}}{10}{figure.caption.23}\protected@file@percent }
\newlabel{fig:exp2_loss}{{10}{10}{Train loss (top) and test loss (bottom) on log scale. The classic grokking signature: train loss drops immediately (memorisation), test loss follows much later (generalisation)}{figure.caption.23}{}}
