\@writefile{lof}{\contentsline {figure}{\numberline {12}{\ignorespaces Client drift (red, left axis) and test accuracy (blue, right axis) over time. Drift peaks during the grokking transition and drops sharply once the network settles into the Fourier solution.}}{12}{figure.caption.27}\protected@file@percent }
