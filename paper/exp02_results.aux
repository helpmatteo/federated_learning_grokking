\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Phase diagram in $(\alpha , K)$ space. Each cell is coloured by outcome category: \textbf  {gray} = below the centralized phase boundary ($\alpha = 0.2$), \textbf  {green} = both FL and centralized-reduced grok, \textbf  {\textcolor {rescueblue}{blue}} = FL groks but centralized-reduced does not (aggregation rescues), \textbf  {red} = neither FL nor centralized-reduced groks (fragmentation overwhelms). Annotations show the FL grokking success rate.}}{2}{figure.caption.5}\protected@file@percent }
