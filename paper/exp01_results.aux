\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces Experiment 0: $T_{\text  {grok}}$ across widths and training fractions.}}{1}{table.caption.4}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:exp0}{{1}{1}{Experiment 0: $T_{\text {grok}}$ across widths and training fractions}{table.caption.4}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces Experiment 0 summary. \textbf  {Left:} $T_{\text  {grok}}$ vs.\ width---flat at each $\alpha $; red crosses indicate no grokking. \textbf  {Centre:} Final test accuracy heatmap; clean binary transition between $\alpha = 0.1$ (0\%) and $\alpha = 0.3$ (100\%). \textbf  {Right:} Final IPR confirms Fourier structure only forms when grokking occurs.}}{2}{figure.caption.5}\protected@file@percent }
\newlabel{fig:exp0_summary}{{1}{2}{Experiment 0 summary. \textbf {Left:} $T_{\text {grok}}$ vs.\ width---flat at each $\alpha $; red crosses indicate no grokking. \textbf {Centre:} Final test accuracy heatmap; clean binary transition between $\alpha = 0.1$ (0\%) and $\alpha = 0.3$ (100\%). \textbf {Right:} Final IPR confirms Fourier structure only forms when grokking occurs}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces Test accuracy curves for all Exp~0 runs. At $\alpha = 0.3$ and $0.5$, the classic grokking S-curve is visible, with all widths overlapping. At $\alpha = 0.1$, test accuracy is indistinguishable from chance ($1/97 \approx 1\%$).}}{2}{figure.caption.6}\protected@file@percent }
\newlabel{fig:exp0_curves}{{2}{2}{Test accuracy curves for all Exp~0 runs. At $\alpha = 0.3$ and $0.5$, the classic grokking S-curve is visible, with all widths overlapping. At $\alpha = 0.1$, test accuracy is indistinguishable from chance ($1/97 \approx 1\%$)}{figure.caption.6}{}}
\@writefile{toc}{\contentsline {section}{\numberline {2}Experiment 1: Centralized Phase Boundary}{3}{section.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Goal.}{3}{section*.7}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Setup.}{3}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Phase boundary results (at $S_{\max } = 100{,}000$).}{3}{section*.9}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces Experiment 1: Phase boundary at $S_{\max } = 100{,}000$.}}{3}{table.caption.10}\protected@file@percent }
\newlabel{tab:exp1}{{2}{3}{Experiment 1: Phase boundary at $S_{\max } = 100{,}000$}{table.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces Grokking wavefront. Each row is one $\alpha $ value; colour encodes test accuracy over time. The sharp horizontal edge between $\alpha = 0.2$ and $0.3$ is the phase boundary. Stars mark $T_{\text  {grok}}$.}}{4}{figure.caption.11}\protected@file@percent }
\newlabel{fig:exp1_heatmap}{{3}{4}{Grokking wavefront. Each row is one $\alpha $ value; colour encodes test accuracy over time. The sharp horizontal edge between $\alpha = 0.2$ and $0.3$ is the phase boundary. Stars mark $T_{\text {grok}}$}{figure.caption.11}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces Generalisation gap (train acc $-$ test acc) over time. All $\alpha $ values memorise by $\sim 2{,}000$ steps (gap $\to 100\%$). For $\alpha \geq 0.3$, the gap collapses as grokking completes. For $\alpha \leq 0.2$, the gap remains at $100\%$ permanently.}}{4}{figure.caption.12}\protected@file@percent }
\newlabel{fig:exp1_gen_gap}{{4}{4}{Generalisation gap (train acc $-$ test acc) over time. All $\alpha $ values memorise by $\sim 2{,}000$ steps (gap $\to 100\%$). For $\alpha \geq 0.3$, the gap collapses as grokking completes. For $\alpha \leq 0.2$, the gap remains at $100\%$ permanently}{figure.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces Train and test loss (log scale) for each $\alpha $. Below the boundary ($\alpha \leq 0.15$), test loss rises monotonically. At $\alpha = 0.2$, test loss plateaus. At $\alpha \geq 0.3$, test loss eventually plunges---the grokking moment.}}{5}{figure.caption.13}\protected@file@percent }
\newlabel{fig:exp1_loss}{{5}{5}{Train and test loss (log scale) for each $\alpha $. Below the boundary ($\alpha \leq 0.15$), test loss rises monotonically. At $\alpha = 0.2$, test loss plateaus. At $\alpha \geq 0.3$, test loss eventually plunges---the grokking moment}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Seed consistency at key $\alpha $ values. At $\alpha = 0.2$, all 3 seeds agree: no grokking. At $\alpha = 0.3$, all 3 grok within 700 steps of each other. The phenomenon is highly reproducible.}}{5}{figure.caption.14}\protected@file@percent }
\newlabel{fig:exp1_seeds}{{6}{5}{Seed consistency at key $\alpha $ values. At $\alpha = 0.2$, all 3 seeds agree: no grokking. At $\alpha = 0.3$, all 3 grok within 700 steps of each other. The phenomenon is highly reproducible}{figure.caption.14}{}}
