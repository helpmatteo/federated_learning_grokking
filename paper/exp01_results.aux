\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces $\alpha = 0.2$ groks at $T_{\text  {grok}} = 805{,}000$---roughly $100\times $ slower than $\alpha = 0.5$. \textbf  {Left:} Test accuracy curves for $\alpha \in \{0.2, 0.3, 0.5\}$. \textbf  {Centre:} IPR at $\alpha = 0.2$ is still climbing at $1$M steps. \textbf  {Right:} Log-scale view reveals the $\sim 100\times $ gap.}}{6}{figure.caption.17}\protected@file@percent }
\newlabel{fig:exp1_alpha02}{{7}{6}{$\alpha = 0.2$ groks at $T_{\text {grok}} = 805{,}000$---roughly $100\times $ slower than $\alpha = 0.5$. \textbf {Left:} Test accuracy curves for $\alpha \in \{0.2, 0.3, 0.5\}$. \textbf {Centre:} IPR at $\alpha = 0.2$ is still climbing at $1$M steps. \textbf {Right:} Log-scale view reveals the $\sim 100\times $ gap}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {paragraph}{Fine-grained boundary scouting.}{6}{section*.18}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces Refined phase boundary: $T_{\text  {grok}}$ vs.\ $\alpha $ and dataset size.}}{6}{table.caption.19}\protected@file@percent }
\newlabel{tab:exp1_refined}{{3}{6}{Refined phase boundary: $T_{\text {grok}}$ vs.\ $\alpha $ and dataset size}{table.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces Refined phase boundary with dataset sizes annotated. \textbf  {Left:} $T_{\text  {grok}}$ vs.\ $\alpha $ on log scale; the green band marks $\alpha = 0.25$, the practical sweet spot for FL experiments. \textbf  {Centre:} $T_{\text  {grok}}$ vs.\ $n_{\text  {train}}$ on log-log axes. \textbf  {Right:} Test accuracy curves zoomed to $200{,}000$ steps.}}{7}{figure.caption.20}\protected@file@percent }
\newlabel{fig:exp1_refined}{{8}{7}{Refined phase boundary with dataset sizes annotated. \textbf {Left:} $T_{\text {grok}}$ vs.\ $\alpha $ on log scale; the green band marks $\alpha = 0.25$, the practical sweet spot for FL experiments. \textbf {Centre:} $T_{\text {grok}}$ vs.\ $n_{\text {train}}$ on log-log axes. \textbf {Right:} Test accuracy curves zoomed to $200{,}000$ steps}{figure.caption.20}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {2.2}Mechanistic Analysis: Critical Scaling}{8}{subsection.2.2}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Key finding.}{8}{section*.21}\protected@file@percent }
\newlabel{eq:scaling}{{1}{8}{Key finding}{equation.1}{}}
\@writefile{toc}{\contentsline {paragraph}{Interpretation.}{8}{section*.22}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Mechanistic picture (Figure~\ref {fig:exp1_mech}).}{8}{section*.23}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces Mechanistic investigation of the phase boundary. \textbf  {(1)}~Fourier structure formation rate: all $\alpha $ build the same representation at different speeds. \textbf  {(2)}~First-layer weight growth drives grokking. \textbf  {(3)}~Test loss inflection point = grokking onset. \textbf  {(4)}~Phase portrait: all trajectories follow the same attractor. \textbf  {(5)}~Train loss vs.\ IPR: memorisation precedes organisation. \textbf  {(6)}~Power-law fit: $T_{\text  {grok}} \propto (\alpha - 0.198)^{-0.99}$, $R^2 = 0.978$.}}{9}{figure.caption.24}\protected@file@percent }
\newlabel{fig:exp1_mech}{{9}{9}{Mechanistic investigation of the phase boundary. \textbf {(1)}~Fourier structure formation rate: all $\alpha $ build the same representation at different speeds. \textbf {(2)}~First-layer weight growth drives grokking. \textbf {(3)}~Test loss inflection point = grokking onset. \textbf {(4)}~Phase portrait: all trajectories follow the same attractor. \textbf {(5)}~Train loss vs.\ IPR: memorisation precedes organisation. \textbf {(6)}~Power-law fit: $T_{\text {grok}} \propto (\alpha - 0.198)^{-0.99}$, $R^2 = 0.978$}{figure.caption.24}{}}
