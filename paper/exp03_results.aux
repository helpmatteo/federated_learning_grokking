\@writefile{toc}{\contentsline {subsection}{\numberline {1.2}Exp~3a: Dirichlet Heterogeneity Sweep}{1}{subsection.1.2}\protected@file@percent }
\newlabel{sec:exp3a}{{1.2}{1}{Exp~3a: Dirichlet Heterogeneity Sweep}{subsection.1.2}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.2.1}Phase diagram}{1}{subsubsection.1.2.1}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {1}{\ignorespaces \textbf  {Exp~3a: Full Dirichlet sweep} ($K{=}10$, mean $T_{\mathrm  {grok}} \pm $ std over 3 seeds). Slowdown column shows ratio vs.\ IID ($\alpha _{\mathrm  {dir}}{=}1000$).}}{2}{table.caption.1}\protected@file@percent }
\providecommand*\caption@xref[2]{\@setref\relax\@undefined{#1}}
\newlabel{tab:exp3a}{{1}{2}{\textbf {Exp~3a: Full Dirichlet sweep} ($K{=}10$, mean $T_{\mathrm {grok}} \pm $ std over 3 seeds). Slowdown column shows ratio vs.\ IID ($\alpha _{\mathrm {dir}}{=}1000$)}{table.caption.1}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {1}{\ignorespaces \textbf  {Exp~3a phase diagram.} Left: mean $T_{\mathrm  {grok}}$ (steps) as a function of $\alpha $ and $\alpha _{\mathrm  {dir}}$ ($K{=}10$). Right: grokking success rate (fraction of seeds that grok). Grokking succeeds at 100\% for all $\alpha \geq 0.25$, regardless of heterogeneity. $\alpha {=}0.2$ universally fails (red $\infty $ markers).}}{2}{figure.caption.2}\protected@file@percent }
\newlabel{fig:exp3a-phase}{{1}{2}{\textbf {Exp~3a phase diagram.} Left: mean $T_{\mathrm {grok}}$ (steps) as a function of $\alpha $ and $\alpha _{\mathrm {dir}}$ ($K{=}10$). Right: grokking success rate (fraction of seeds that grok). Grokking succeeds at 100\% for all $\alpha \geq 0.25$, regardless of heterogeneity. $\alpha {=}0.2$ universally fails (red $\infty $ markers)}{figure.caption.2}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {2}{\ignorespaces \textbf  {Grokking time vs.\ heterogeneity.} $T_{\mathrm  {grok}}$ (mean $\pm $ std over 3 seeds) as a function of $\alpha _{\mathrm  {dir}}$ for each training fraction. The effect of heterogeneity is largest near the phase boundary ($\alpha {=}0.25$) and negligible in the interior ($\alpha {=}0.5$). Note log scale on $x$-axis.}}{2}{figure.caption.3}\protected@file@percent }
\newlabel{fig:exp3a-tgrok-vs-dir}{{2}{2}{\textbf {Grokking time vs.\ heterogeneity.} $T_{\mathrm {grok}}$ (mean $\pm $ std over 3 seeds) as a function of $\alpha _{\mathrm {dir}}$ for each training fraction. The effect of heterogeneity is largest near the phase boundary ($\alpha {=}0.25$) and negligible in the interior ($\alpha {=}0.5$). Note log scale on $x$-axis}{figure.caption.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.2.2}$K$-validation}{3}{subsubsection.1.2.2}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {3}{\ignorespaces \textbf  {$K$-validation.} $K{=}10$ (solid) vs.\ $K{=}20$ (dashed). Increasing $K$ modestly amplifies heterogeneity-induced delay near the boundary but does not shift the phase boundary itself.}}{3}{figure.caption.4}\protected@file@percent }
\newlabel{fig:exp3a-kval}{{3}{3}{\textbf {$K$-validation.} $K{=}10$ (solid) vs.\ $K{=}20$ (dashed). Increasing $K$ modestly amplifies heterogeneity-induced delay near the boundary but does not shift the phase boundary itself}{figure.caption.4}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.3}Exp~3b: Structured Partitions}{3}{subsection.1.3}\protected@file@percent }
\newlabel{sec:exp3b}{{1.3}{3}{Exp~3b: Structured Partitions}{subsection.1.3}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.3.1}Operand vs.\ target vs.\ IID}{3}{subsubsection.1.3.1}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {4}{\ignorespaces \textbf  {Exp~3b: Structured partition comparison.} $T_{\mathrm  {grok}}$ by partition type for each $\alpha $ ($K{=}10$). Operand and target partitions produce grokking times within noise of IID.}}{4}{figure.caption.5}\protected@file@percent }
\newlabel{fig:exp3b-struct}{{4}{4}{\textbf {Exp~3b: Structured partition comparison.} $T_{\mathrm {grok}}$ by partition type for each $\alpha $ ($K{=}10$). Operand and target partitions produce grokking times within noise of IID}{figure.caption.5}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces \textbf  {Structured partition trajectories} (seed~42). Top: test accuracy; bottom: IPR. The three partition types produce nearly indistinguishable dynamics at all training fractions.}}{4}{figure.caption.6}\protected@file@percent }
\newlabel{fig:exp3b-traj}{{5}{4}{\textbf {Structured partition trajectories} (seed~42). Top: test accuracy; bottom: IPR. The three partition types produce nearly indistinguishable dynamics at all training fractions}{figure.caption.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {2}{\ignorespaces \textbf  {Exp~3b: Grokking time by partition type} ($K{=}10$, mean $\pm $ std over 3 seeds). Slowdown ratio is relative to IID ($\alpha _{\mathrm  {dir}}{=}1000$) from Exp~3a.}}{5}{table.caption.7}\protected@file@percent }
\newlabel{tab:exp3b}{{2}{5}{\textbf {Exp~3b: Grokking time by partition type} ($K{=}10$, mean $\pm $ std over 3 seeds). Slowdown ratio is relative to IID ($\alpha _{\mathrm {dir}}{=}1000$) from Exp~3a}{table.caption.7}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {1.4}Mechanistic Analysis}{5}{subsection.1.4}\protected@file@percent }
\newlabel{sec:exp3-mech}{{1.4}{5}{Mechanistic Analysis}{subsection.1.4}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.4.1}Grokking anatomy}{5}{subsubsection.1.4.1}\protected@file@percent }
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.4.2}Weight norm dynamics}{5}{subsubsection.1.4.2}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {3}{\ignorespaces \textbf  {Generalization onset and transition width} (seed~42). $T_{\mathrm  {onset}}$: first step with test accuracy $>$5\%. Gap $= T_{\mathrm  {grok}} - T_{\mathrm  {onset}}$.}}{6}{table.caption.8}\protected@file@percent }
\newlabel{tab:tonset}{{3}{6}{\textbf {Generalization onset and transition width} (seed~42). $T_{\mathrm {onset}}$: first step with test accuracy $>$5\%. Gap $= T_{\mathrm {grok}} - T_{\mathrm {onset}}$}{table.caption.8}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces \textbf  {Grokking anatomy} (seed~42). Four conditions spanning comfortable ($\alpha {=}0.3$) to near-boundary ($\alpha {=}0.25$), under IID and extreme non-IID. Green dotted line: $T_{\mathrm  {onset}}$ (first $>$5\% test accuracy); red dashed: $T_{\mathrm  {grok}}$ ($>$95\% permanently). Rows: (a)~test accuracy, (b)~generalization gap, (c)~mean client drift, (d)~IPR and $\|W_2\|/\|W_1\|$ ratio.}}{6}{figure.caption.9}\protected@file@percent }
\newlabel{fig:anatomy}{{6}{6}{\textbf {Grokking anatomy} (seed~42). Four conditions spanning comfortable ($\alpha {=}0.3$) to near-boundary ($\alpha {=}0.25$), under IID and extreme non-IID. Green dotted line: $T_{\mathrm {onset}}$ (first $>$5\% test accuracy); red dashed: $T_{\mathrm {grok}}$ ($>$95\% permanently). Rows: (a)~test accuracy, (b)~generalization gap, (c)~mean client drift, (d)~IPR and $\|W_2\|/\|W_1\|$ ratio}{figure.caption.9}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces \textbf  {Weight norm evolution} (seed~42). Top: layer-1 norm; bottom: layer-2 norm. Non-IID slows growth in both layers, with a larger effect on layer~2. Final norms converge regardless of heterogeneity.}}{7}{figure.caption.10}\protected@file@percent }
\newlabel{fig:weight-norms}{{7}{7}{\textbf {Weight norm evolution} (seed~42). Top: layer-1 norm; bottom: layer-2 norm. Non-IID slows growth in both layers, with a larger effect on layer~2. Final norms converge regardless of heterogeneity}{figure.caption.10}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces \textbf  {Weight norm ratio} ($\|W_2\|/\|W_1\|$) over training (seed~42). All grokking runs converge to the same ratio $\approx 0.8$--$0.9$. Under non-IID, the ratio is suppressed during training, indicating heterogeneity preferentially slows the output layer.}}{7}{figure.caption.11}\protected@file@percent }
\newlabel{fig:weight-ratio}{{8}{7}{\textbf {Weight norm ratio} ($\|W_2\|/\|W_1\|$) over training (seed~42). All grokking runs converge to the same ratio $\approx 0.8$--$0.9$. Under non-IID, the ratio is suppressed during training, indicating heterogeneity preferentially slows the output layer}{figure.caption.11}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.4.3}Client drift and feature quality}{8}{subsubsection.1.4.3}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {9}{\ignorespaces \textbf  {Client drift dynamics} (seed~42). Top: mean client drift; bottom: client weight divergence. Drift scales with heterogeneity; weight divergence shows a characteristic spike at the grokking transition.}}{8}{figure.caption.12}\protected@file@percent }
\newlabel{fig:drift-dynamics}{{9}{8}{\textbf {Client drift dynamics} (seed~42). Top: mean client drift; bottom: client weight divergence. Drift scales with heterogeneity; weight divergence shows a characteristic spike at the grokking transition}{figure.caption.12}{}}
\@writefile{toc}{\contentsline {subsubsection}{\numberline {1.4.4}Reproducibility and seed variability}{8}{subsubsection.1.4.4}\protected@file@percent }
\@writefile{lof}{\contentsline {figure}{\numberline {10}{\ignorespaces \textbf  {Drift--IPR correlation at grokking.} Each point is one run (all seeds). Left: client drift vs.\ IPR at $T_{\mathrm  {grok}}$; right: weight divergence vs.\ IPR. Among grokked runs, IPR is tightly clustered regardless of drift---feature quality is independent of the heterogeneity experienced during training. The low-IPR cluster (${\sim }0.03$--$0.06$) corresponds to $\alpha {=}0.2$ runs that did not grok.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:drift-ipr}{{10}{9}{\textbf {Drift--IPR correlation at grokking.} Each point is one run (all seeds). Left: client drift vs.\ IPR at $T_{\mathrm {grok}}$; right: weight divergence vs.\ IPR. Among grokked runs, IPR is tightly clustered regardless of drift---feature quality is independent of the heterogeneity experienced during training. The low-IPR cluster (${\sim }0.03$--$0.06$) corresponds to $\alpha {=}0.2$ runs that did not grok}{figure.caption.13}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {11}{\ignorespaces \textbf  {Per-seed variability.} Top: test accuracy; bottom: IPR. Columns span from comfortable ($\alpha {=}0.5$, IID) to maximally stressed ($\alpha {=}0.25$, $\alpha _{\mathrm  {dir}}{=}0.01$). Timing variance increases near the boundary under heterogeneity, but all seeds converge to the same solution.}}{9}{figure.caption.14}\protected@file@percent }
\newlabel{fig:per-seed}{{11}{9}{\textbf {Per-seed variability.} Top: test accuracy; bottom: IPR. Columns span from comfortable ($\alpha {=}0.5$, IID) to maximally stressed ($\alpha {=}0.25$, $\alpha _{\mathrm {dir}}{=}0.01$). Timing variance increases near the boundary under heterogeneity, but all seeds converge to the same solution}{figure.caption.14}{}}
