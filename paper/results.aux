\@writefile{toc}{\contentsline {section}{\numberline {5}Discussion}{4}{section.5}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Grokking is a property of the loss landscape, not the optimisation path.}{4}{section*.8}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{The proximal term directly opposes grokking.}{4}{section*.9}\protected@file@percent }
\@writefile{toc}{\contentsline {paragraph}{Partial participation is the only weak point.}{4}{section*.10}\protected@file@percent }
